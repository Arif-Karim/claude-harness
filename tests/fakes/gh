#!/usr/bin/env python3
"""A fake `gh` for the merge-gate tests. Put tests/fakes first on PATH.

Routes come from the JSON file named by $FAKE_GH_ROUTES: a list of objects
  {"match": "<regex>", "stdout": <str|json>, "pages": [<str|json>, ...],
   "exit": 0, "stderr": "", "sequence": [<response>, ...]}
`match` is searched (re.search, DOTALL) in the argv joined with single spaces, with
any `--jq/-q EXPR` pair removed. Tests anchor it (^...$) on the full path and query
string, so a dropped or changed query parameter is an unmatched call. The first
matching route wins. An unmatched call prints an error and exits 1, so a script
that calls something unexpected fails. With `sequence`, the k-th call to the route
gets the k-th response (the last one repeats); each response has the route keys.

Like real gh:
  * `--jq/-q EXPR` filters each page through `jq -r EXPR` (jq errors exit 1);
  * `pages` emits every page only with `--paginate`; without it, just the first;
  * `api graphql --paginate` needs a query that declares `$endCursor`, uses it as
    `after:$endCursor` and selects `pageInfo{hasNextPage endCursor}`, else exit 1;
    a declared but unused `$endCursor` is an error (GitHub rejects unused variables);
  * `--input -` reads stdin.
Every call is appended to $FAKE_GH_LOG (if set) as one JSON line {"argv", "stdin"}.
"""
import json
import os
import re
import subprocess
import sys


def split_jq(argv):
    rest, expr, i = [], None, 0
    while i < len(argv):
        a = argv[i]
        if a in ("--jq", "-q") and i + 1 < len(argv):
            expr = argv[i + 1]
            i += 2
            continue
        if a.startswith("--jq="):
            expr = a[len("--jq="):]
        else:
            rest.append(a)
        i += 1
    return rest, expr


def graphql_error(rest):
    """What real gh / GitHub would reject about a graphql call, or None."""
    query = next((a.split("=", 1)[1] for a in rest if a.startswith("query=")), "")
    declared = re.search(r"\$endCursor\s*:\s*String\b", query) is not None
    used = re.search(r"after\s*:\s*\$endCursor\b", query) is not None
    page_info = re.search(r"pageInfo\s*\{\s*(hasNextPage\s+endCursor|endCursor\s+hasNextPage)\s*\}", query)
    if declared and not used:
        return "Variable $endCursor is declared by anonymous query but not used"
    if "--paginate" in rest and not (declared and used and page_info):
        return ("--paginate needs a query that declares $endCursor: String, uses after:$endCursor "
                "and selects pageInfo{hasNextPage endCursor}")
    return None


def pick(route):
    seq = route.get("sequence")
    if not seq:
        return route
    counter = os.environ["FAKE_GH_ROUTES"] + ".count"
    counts = {}
    if os.path.exists(counter):
        with open(counter, encoding="utf-8") as f:
            counts = json.load(f)
    k = counts.get(route["match"], 0)
    counts[route["match"]] = k + 1
    with open(counter, "w", encoding="utf-8") as f:
        json.dump(counts, f)
    return seq[min(k, len(seq) - 1)]


def render(page):
    return page if isinstance(page, str) else json.dumps(page)


def main(argv):
    rest, expr = split_jq(argv)
    stdin = ""
    if "--input" in rest and rest[rest.index("--input") + 1:][:1] == ["-"]:
        stdin = sys.stdin.read()
    log = os.environ.get("FAKE_GH_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as f:
            f.write(json.dumps({"argv": argv, "stdin": stdin}) + "\n")

    with open(os.environ["FAKE_GH_ROUTES"], encoding="utf-8") as f:
        routes = json.load(f)
    joined = " ".join(rest)
    route = next((r for r in routes if re.search(r["match"], joined, re.DOTALL)), None)
    if route is None:
        sys.stderr.write(f"fake gh: no route for: gh {joined}\n")
        return 1
    if rest[:2] == ["api", "graphql"]:
        err = graphql_error(rest)
        if err:
            sys.stderr.write(f"fake gh: {err}\n")
            return 1
    route = pick(route)

    if "pages" in route:
        pages = route["pages"] if "--paginate" in rest else route["pages"][:1]
    elif "stdout" in route:
        pages = [route["stdout"]]
    else:
        pages = []
    for page in pages:
        text = render(page)
        if expr is not None:
            p = subprocess.run(["jq", "-r", expr], input=text, capture_output=True, text=True, check=False)
            if p.returncode != 0:
                sys.stderr.write(p.stderr)
                return 1
            text = p.stdout
        sys.stdout.write(text if text.endswith("\n") or not text else text + "\n")
    sys.stderr.write(route.get("stderr", ""))
    return int(route.get("exit", 0))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
